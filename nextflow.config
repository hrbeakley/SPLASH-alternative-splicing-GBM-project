params {

    sra_acc_list = "$projectDir/inputs/SRR_Acc_List.txt"
    samplesheet = "$projectDir/inputs/samplesheet.txt"
    accession = "GCF_009914755.1"
    anchor_len = 21

    // Directories
    outdir = "$projectDir/results/"
    refdir = "$projectDir/refs/"
    fastqdir = "$projectDir/fastqs/"
}

profiles {
    conda {
        conda.enabled = true
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
    }
    cluster {
        process {
                executor = 'sge'
                clusterOptions = '-P bf528'
                penv = 'omp'

                withLabel: process_single {
                    cpus = 1
                }

                withLabel: process_low {
                    cpus = 4

                }
                withLabel: process_medium {
                    cpus = 8
                }
                
                withLabel: process_high {
                    cpus = 16
                }
        }
    }

    local {
        process.executor = 'local'
    }
}

executor {
    $sge {
        queueSize = 8
    }
    $local {
        cpus = 1
    }
}

resume = true